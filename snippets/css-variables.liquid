{%- liquid
  assign font_primary = settings.type_primary_font
  
  # Default Fallback (Primary)
  assign primary_family = font_primary.family | append: ', ' | append: font_primary.fallback_families
  
  # Logic for Main/Body Font
  if settings.custom_main_font_url != blank and settings.custom_main_font_name != blank
    assign primary_family = "'" | append: settings.custom_main_font_name | append: "', " | append: font_primary.fallback_families
  endif

  # Logic for Heading Font (h1)
  assign heading_family = primary_family
  if settings.custom_heading_font_url != blank and settings.custom_heading_font_name != blank
    assign heading_family = "'" | append: settings.custom_heading_font_name | append: "', " | append: font_primary.fallback_families
  endif

  # Logic for Subheading Font (h2, h3, h4)
  assign subheading_family = primary_family
  if settings.custom_subheading_font_url != blank and settings.custom_subheading_font_name != blank
    assign subheading_family = "'" | append: settings.custom_subheading_font_name | append: "', " | append: font_primary.fallback_families
  endif
-%}

{% style %}
  {{ font_primary | font_face: font_display: 'swap' }}

  {%- comment -%} Define @font-face for each if they exist {%- endcomment -%}
  {% if settings.custom_main_font_url != blank %}
    @font-face {
      font-family: '{{ settings.custom_main_font_name | escape }}';
      src: url('{{ settings.custom_main_font_url | strip }}') format('woff2');
      font-weight: 400; font-style: normal; font-display: swap;
    }
  {% endif %}

  {% if settings.custom_heading_font_url != blank %}
    @font-face {
      font-family: '{{ settings.custom_heading_font_name | escape }}';
      src: url('{{ settings.custom_heading_font_url | strip }}') format('woff2');
      font-weight: 700; font-style: normal; font-display: swap;
    }
  {% endif %}

  {% if settings.custom_subheading_font_url != blank %}
    @font-face {
      font-family: '{{ settings.custom_subheading_font_name | escape }}';
      src: url('{{ settings.custom_subheading_font_url | strip }}') format('woff2');
      font-weight: 600; font-style: normal; font-display: swap;
    }
  {% endif %}

  :root {
    --font-primary--family: {{ primary_family }};
    --font-heading--family: {{ heading_family }};
    --font-subheading--family: {{ subheading_family }};
    
    --font-primary--style: {{ font_primary.style }};
    --font-primary--weight: {{ font_primary.weight }};
  }
{% endstyle %}